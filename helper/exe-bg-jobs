#!/usr/bin/env python3
import sys
if len(sys.argv) < 3:
    print('Usage: ' + sys.argv[0] + ' output-dir main-pid')
    exit(1)
import os
mydir = os.path.dirname(sys.argv[0])
output_dir = os.path.realpath(sys.argv[1])
main_pid = sys.argv[2]

import signal
should_exit = False
def mark_should_exit(sig=None, frame=None):
    global should_exit
    should_exit = True
signal.signal(signal.SIGINT, mark_should_exit)
signal.signal(signal.SIGTERM, mark_should_exit)

from dataclasses import dataclass
import subprocess

@dataclass
class ProcessInfo:
    setsid: bool
    signal: signal.Signals
pids_to_kill = {}
pid = subprocess.Popen([os.path.join(mydir, 'bg-jobs', 'du.sh'), output_dir], preexec_fn=os.setsid).pid
pids_to_kill[pid] = ProcessInfo(setsid=True, signal=signal.SIGTERM)
pid = subprocess.Popen([os.path.join(mydir, 'bg-jobs', 'iostat.sh'), output_dir], preexec_fn=os.setsid).pid
pids_to_kill[pid] = ProcessInfo(setsid=True, signal=signal.SIGTERM)

if int(os.getenv('with_perf', '0')) != 0:
    pid = subprocess.Popen(['perf', 'record', '--pid', str(main_pid), '--call-graph=fp', '--aio', '-z', '-o', os.path.join(output_dir, 'perf.data')]).pid
    pids_to_kill[pid] = ProcessInfo(setsid=False, signal=signal.SIGTERM)

if int(os.getenv('with_offcputime', '0')) != 0:
    with open(os.path.join(output_dir, 'offcputime.stacks'), 'w') as f:
        os.chdir('/') # Avoid getcwd error in offcputime
        pid = subprocess.Popen(['sudo', 'offcputime-bpfcc', '-df', '-p', main_pid], stdout=f).pid
        pids_to_kill[pid] = ProcessInfo(setsid=False, signal=signal.SIGINT)

def on_chld(sig=None, frame=None):
    global should_exit
    global pids_to_kill
    if should_exit:
        return
    while True:
        try:
            reaped_pid, status = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            break
        if reaped_pid == 0:
            break
        if reaped_pid in pids_to_kill.keys():
            del pids_to_kill[reaped_pid]
            should_exit = True
            break
signal.signal(signal.SIGCHLD, on_chld)
on_chld()

while not should_exit:
    # Is it possible that the signal is handled here and the signal.pause below can't wake up?
	signal.pause()

print('exe-bg-jobs: exiting...', file=sys.stderr)
for (pid, info) in pids_to_kill.items():
    try:
        if info.setsid:
            os.killpg(pid, info.signal)
        else:
            os.kill(pid, info.signal)
    except ProcessLookupError:
        pass
while True:
    try:
        os.wait()
    except ChildProcessError:
        break
