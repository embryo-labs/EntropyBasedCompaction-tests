#!/usr/bin/env python3
import os
import sys
if len(sys.argv) < 3:
	print('Usage: ' + sys.argv[0] + ' output-dir command args...')
	exit(1)
mydir = os.path.dirname(sys.argv[0])
output_dir = sys.argv[1]
cmd = sys.argv[2:]

import fcntl
wakeup_fd, wakeup_fd_w = os.pipe()
fcntl.fcntl(wakeup_fd_w, fcntl.F_SETFL, os.O_NONBLOCK)
def wakeup():
    global wakeup_fd_w
    try:
        os.write(wakeup_fd_w, b'1')
    except BlockingIOError:
        pass

import signal
should_exit = False
exit_code = 0

def status_to_exit_code(status):
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return 1

def mark_should_exit(sig, frame):
    global should_exit
    global exit_code
    should_exit = True
    exit_code = 128 + int(sig)
    wakeup()
signal.signal(signal.SIGINT, mark_should_exit)
signal.signal(signal.SIGTERM, mark_should_exit)

os.makedirs(output_dir, exist_ok=True)

import tempfile
tmp_dir = tempfile.mkdtemp()

db_bench_exit_later = os.environ.get('with_offcputime', '0') != '0'
if db_bench_exit_later:
    os.mkfifo(os.path.join(tmp_dir, 'db-bench-done'))
    os.mkfifo(os.path.join(tmp_dir, 'db-bench-can-exit'))
    cmd.extend(['--exec_before_exit', 'echo db_bench done 1>&2; echo 1 > ' + tmp_dir + '/db-bench-done; echo db_bench waiting for permission to exit 1>&2; read x < ' + tmp_dir + '/db-bench-can-exit; echo db_bench exit 1>&2'])

import subprocess
main_job = subprocess.Popen(cmd, preexec_fn=os.setsid)
main_pgid = os.getpgid(main_job.pid)

bg_job = subprocess.Popen([os.path.join(mydir, 'exe-bg-jobs'), output_dir, str(main_job.pid)], stdout=sys.stderr)

import threading
mutex = threading.Lock()
pids_to_kill = [main_job.pid, bg_job.pid]
pids_expected_alive = [main_job.pid, bg_job.pid]

def on_chld(sig=None, frame=None):
    global should_exit
    global mutex, pids_to_kill, pids_expected_alive
    global exit_code
    while True:
        try:
            reaped_pid, status = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            break
        if reaped_pid == 0:
            break
        with mutex:
            if reaped_pid in pids_expected_alive:
                pids_to_kill.remove(reaped_pid)
                pids_expected_alive.remove(reaped_pid)
                if should_exit:
                    break
                if reaped_pid == main_job.pid:
                    exit_code = status_to_exit_code(status)
                elif reaped_pid == bg_job.pid:
                    exit_code = 1
                    print('exe-while: background job exited before db_bench', file=sys.stderr)
                should_exit = True
                wakeup()
                break
signal.signal(signal.SIGCHLD, on_chld)
# In case that CHLD has already been signaled before we installed the signal handler.
on_chld()

import select
def kill_bg_job_when_db_bench_done(thread_should_stop, tmp_dir, main_job, bg_job):
    global should_exit
    global mutex, pids_to_kill, pids_expected_alive
    global exit_code

    print('Waiting for db_bench to be done', file=sys.stderr)
    rlist = [thread_should_stop]
    fd_db_bench_done = None
    if db_bench_exit_later:
        fd_db_bench_done = os.open(os.path.join(tmp_dir, 'db-bench-done'), os.O_RDONLY | os.O_NONBLOCK)
        rlist.append(fd_db_bench_done)
    rlist, _, _ = select.select(rlist, [], [])
    if thread_should_stop in rlist:
        return
    assert fd_db_bench_done is not None
    assert fd_db_bench_done in rlist
    os.read(fd_db_bench_done, 1)
    print('ACK db_bench done', file=sys.stderr)

    print('Terminating bg jobs', file=sys.stderr)
    with mutex:
        pids_to_kill.remove(bg_job.pid)
        pids_expected_alive.remove(bg_job.pid)
    bg_job.terminate()
    bg_job.wait()
    print('Terminated bg jobs. Permit db_bench to exit', file=sys.stderr)
    fd_db_bench_can_exit = os.open(os.path.join(tmp_dir, 'db-bench-can-exit'), os.O_RDWR)
    rlist, wlist, _ = select.select([thread_should_stop], [fd_db_bench_can_exit], [])
    if thread_should_stop in rlist:
        return
    assert fd_db_bench_can_exit in wlist
    with mutex:
        pids_expected_alive.remove(main_job.pid)
    os.write(fd_db_bench_can_exit, b'1\n')
    main_job.wait()
    print('ACK db_bench exit', file=sys.stderr)
    with mutex:
        pids_to_kill.remove(main_job.pid)
        exit_code = main_job.returncode
    should_exit = True
    wakeup()
thread_should_stop, thread_should_stop_w = os.pipe()
thread_kill_bg_job_when_db_bench_done = threading.Thread(target=kill_bg_job_when_db_bench_done, args=(thread_should_stop, tmp_dir, main_job, bg_job))
thread_kill_bg_job_when_db_bench_done.start()

while not should_exit:
    os.read(wakeup_fd, 1)

os.close(thread_should_stop_w)
thread_kill_bg_job_when_db_bench_done.join()
signal.signal(signal.SIGCHLD, signal.SIG_DFL)
del mutex, pids_expected_alive

if main_job.pid in pids_to_kill:
    os.killpg(main_pgid, signal.SIGTERM)
if bg_job.pid in pids_to_kill:
    bg_job.terminate()

import shutil
shutil.rmtree(tmp_dir)
sys.exit(exit_code)
